# =============================================================================
# PUBLIC — safe to expose to the browser (Next.js NEXT_PUBLIC_ prefix required).
# These come from Supabase project settings -> API.
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# =============================================================================
# SERVER-ONLY SECRETS — never prefix with NEXT_PUBLIC_. Set these only in:
#   - .env.local for local dev (gitignored)
#   - Netlify site configuration -> Environment variables (Functions scope)
# The service role key bypasses Row Level Security entirely — it must never
# reach client-side JavaScript. It is used only in server actions / route
# handlers running on Netlify Functions.
# =============================================================================
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Gateway — set only the provider(s) you have keys for. The app must run
# correctly with all of these unset; AI features simply show "not configured".
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Used server-side to sign/verify simple idempotency tokens for form
# submission (see src/lib/idempotency.ts). Generate with: openssl rand -hex 32
APP_SECRET=
